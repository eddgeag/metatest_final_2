# Configuración conservadora. Todos los valores pueden sobrescribirse al lanzar.
RESOURCE_MODE=auto

# Nunca usar más de este número de cores visibles para los procesos R del pipeline.
AUTO_MAX_PIPELINE_R_CORES=2
AUTO_CPU_PERCENT=50

# Hilos internos: mantener en 1 evita multiplicación de procesos BLAS/Stan.
BRMS_INTERNAL_CORES=1
BLAS_THREADS=1

# No iniciar un paso pesado con menos de esta RAM disponible.
MIN_AVAILABLE_MEM_GB=12
MEMORY_WAIT_SECONDS=60

# 0 = esperar indefinidamente a que haya RAM; no abortar una corrida semanal.
MEMORY_WAIT_ATTEMPTS=0

# Rechazar el lanzamiento si el filesystem del proyecto tiene menos espacio.
MIN_FREE_DISK_GB=100

# Conserva la configuración funcional ya probada.
CMDSTAN_OPTIMIZATION_LEVEL=0

# Prioridad amable con un servidor compartido.
NICE_LEVEL=10
IONICE_CLASS=2
IONICE_LEVEL=7

# Script principal que ejecutará el wrapper.
ORCHESTRATOR=run_comparacion_modelamiento2_vs_3_memoria_servidor.sh

